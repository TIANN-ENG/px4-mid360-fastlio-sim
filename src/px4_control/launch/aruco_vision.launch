<launch>
  <!-- 下视相机 ArUco 检测：需要先起好 PX4 SITL + Gazebo（vision_cam 模型已在机上） -->
  <arg name="marker_length"     default="0.4"/>
  <arg name="dictionary"        default="DICT_4X4_50"/>
  <!-- gazebo_ros_camera 的话题带模型名前缀，PX4 的实体名是 iris_mid360 -->
  <arg name="image_topic"       default="/iris_mid360/camera/image_raw"/>
  <arg name="camera_info_topic" default="/iris_mid360/camera/camera_info"/>
  <!-- cv2.aruco 的 tvec/rvec 属 OpenCV 光学系（x 右、y 下、z 沿光轴朝前）。
       该 frame 由 mavros_tf.launch 的 camera_link→camera_optical_frame 提供；
       所有机载传感器外参统一在 mavros_tf.launch 发布，这里不再重复发 TF
       （同一个 base_link→camera_link 被两个节点发布会造成 TF 冲突）。 -->
  <arg name="pose_frame"        default="camera_optical_frame"/>

  <node pkg="px4_control" type="aruco_down_cam.py" name="aruco_down_cam" output="screen">
    <param name="marker_length"     value="$(arg marker_length)"/>
    <param name="dictionary"        value="$(arg dictionary)"/>
    <param name="image_topic"       value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="pose_frame"        value="$(arg pose_frame)"/>
  </node>

  <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view"
        args="/aruco_down_cam/debug_image" output="screen"/>
</launch>
