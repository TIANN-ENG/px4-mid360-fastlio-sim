<launch>
  <!-- 起飞 → 悬停 → 相对平移(前进/后退/升降) → 环绕 → 自动降落
       用法：
         roslaunch px4_control offboard_orbit.launch
         roslaunch px4_control offboard_orbit.launch height:=2.5 hover_time:=3 radius:=4 speed:=1.2 clockwise:=true
         roslaunch px4_control offboard_orbit.launch waypoints:="[[2,0,0],[0,0,0.5],[-2,0,0],[0,0,0]]"

       waypoints 每个元素 = [dx, dy, dz] 或 [dx, dy, dz, yaw]
         dx/dy 相对起飞点的水平位移（+x 东=前进，+y 北=左移）
         dz    相对【飞行高度】的升降（不是相对地面）
         yaw   可选；不写则机头自动朝向运动方向
  -->
  <arg name="height"           default="2.0"/>   <!-- 目标高度 m -->
  <arg name="hover_time"       default="5.0"/>   <!-- 起飞后悬停秒数 -->
  <arg name="waypoints"        default="[]"/>    <!-- 平移序列，[] 表示不动 -->
  <arg name="radius"           default="3.0"/>   <!-- 环绕半径 m -->
  <arg name="speed"            default="1.0"/>   <!-- 圆周线速度 m/s -->
  <arg name="laps"             default="1.0"/>   <!-- 环绕圈数，0 表示不环绕 -->
  <arg name="clockwise"        default="false"/> <!-- 是否顺时针 -->
  <arg name="face_tangent"     default="true"/>  <!-- 机头是否朝切线方向 -->

  <node pkg="px4_control" type="offboard_orbit" name="offboard_orbit" output="screen">
    <param name="height"       value="$(arg height)"/>
    <param name="hover_time"   value="$(arg hover_time)"/>
    <param name="radius"       value="$(arg radius)"/>
    <param name="speed"        value="$(arg speed)"/>
    <param name="laps"         value="$(arg laps)"/>
    <param name="clockwise"    value="$(arg clockwise)"/>
    <param name="face_tangent" value="$(arg face_tangent)"/>
    <rosparam param="waypoints" subst_value="true">$(arg waypoints)</rosparam>
  </node>
</launch>
